{{ 'ai-catalog.css' | asset_url | stylesheet_tag }}
<div id="ai-catalog" class="ai-region" data-api="{{ section.settings.api_url | escape }}" data-form="{{ section.settings.form_url | escape }}">
<section class="aic-hero"><div class="ai-wrap"><p class="aic-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}<br><span>{{ section.settings.accent | escape }}</span></h1><p>{{ section.settings.intro | escape }}</p></div></section>
<div class="ai-wrap aic-browser">
<div class="aic-tabs" aria-label="Catalog source"><button type="button" data-source="sanmar" aria-pressed="true">Apparel</button><button type="button" data-source="sage" aria-pressed="false">Promotional Products</button></div>
<section id="aic-category-section" class="aic-category-section" aria-labelledby="aic-browse-heading"><h2 id="aic-browse-heading">Shop by category</h2><div id="aic-category-tiles" class="aic-category-tiles"></div></section><div class="aic-toolbar"><form id="aic-search"><label class="ai-sr" for="aic-query">Search catalog</label><input id="aic-query" type="search" maxlength="100" placeholder="Search apparel by product, brand, or style number"><button class="ai-button" type="submit">Search</button></form><button id="aic-quote-open" class="aic-outline" type="button">Quote list (<span id="aic-count">0</span>)</button></div>
<div class="aic-layout"><aside class="aic-filters"><label for="aic-category">Shop by category</label><select id="aic-category"></select><div id="aic-apparel-filters"><label for="aic-brand">Brand</label><select id="aic-brand"><option value="">All brands</option></select><label for="aic-color">Color</label><select id="aic-color"><option value="">All colors</option></select></div><button id="aic-reset" type="button">Clear filters</button><p id="aic-scope">Browse our apparel selection, or search by style number.</p><a href="/pages/contact">Need sourcing help?</a></aside>
<section class="aic-results" aria-labelledby="aic-heading"><div class="aic-results-head"><h2 id="aic-heading">Featured apparel</h2><label>Sort <select id="aic-sort"><option value="featured">Featured</option><option value="az">Name A–Z</option></select></label></div><p id="aic-status" role="status" aria-live="polite">Loading products…</p><div id="aic-grid" class="aic-grid"></div><div class="aic-pagination"><button id="aic-prev" type="button" hidden>Previous</button><span id="aic-page"></span><button id="aic-next" type="button" hidden>Next</button></div><p id="aic-credit" class="aic-credit"></p></section></div>
</div>
<section class="aic-help"><div class="ai-wrap"><h2>Need help finding the right product?</h2><a class="ai-button" href="/pages/contact">Contact our team</a></div></section>
<dialog id="aic-detail" aria-labelledby="aic-detail-title"><button class="aic-close" type="button" aria-label="Close product details">Close</button><div id="aic-detail-content"></div></dialog>
<dialog id="aic-quote" aria-labelledby="aic-quote-title"><button class="aic-close" type="button" aria-label="Close quote list">Close</button><h2 id="aic-quote-title">Your quote list</h2><p>Choose quantities and share your project details. This is a request for a quote, not an order. Pricing, decoration, availability, and freight will be confirmed by our team.</p><div id="aic-quote-items"></div><p id="aic-quote-status" role="status"></p><button id="aic-continue" class="ai-button" type="button">Continue quote request</button><div id="aic-request-form" hidden><h3>Send your request</h3><p>Your selected products are included in the form below. Complete your contact details and submit once.</p><iframe id="aic-form-frame" title="Catalog quote request" width="100%" height="2150"></iframe><a id="aic-form-link" target="_blank" rel="noopener">Open request form in a new tab</a></div></dialog>
</div>
<script src="{{ 'ai-catalog.js' | asset_url }}" defer></script>
{% schema %}
{"name":"AI Product Catalog","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AI Apparel Group / Catalog"},{"type":"text","id":"heading","label":"Heading","default":"Find your next"},{"type":"text","id":"accent","label":"Accent heading","default":"brand essential."},{"type":"text","id":"intro","label":"Introduction","default":"Apparel and promotional products. One place to build your next project."},{"type":"url","id":"api_url","label":"Catalog API URL"},{"type":"url","id":"form_url","label":"Monday quote form URL"}]}
{% endschema %}
